# ----- LLM (OpenAI-compatible) -----
# Works with OpenAI, DeepSeek, Moonshot, Together, local vLLM/Ollama-openai, etc.
OPENAI_API_KEY=sk-your-key-here
# Optional: override for non-OpenAI compatible endpoints (DeepSeek etc. NEED this)
# OPENAI_BASE_URL=https://api.deepseek.com/v1
BOBANANA_MODEL=gpt-4o-mini
# Global fallback temperature. Per-role temperatures are layered in code
# (reviewer/directive-gate=0 strict; executor hotter to avoid repeating itself).
BOBANANA_TEMPERATURE=0.1

# ----- Intent layer -----
# Sizes each task (0=greeting .. 1=large refactor) and decides on meta-prompting;
# the loop/tool budgets below are scaled DOWN for small tasks (these stay the ceiling).
BOBANANA_ENABLE_INTENT=true

# ----- Review loops (variant ReAct) — CEILING; intent scales down, rejections ratchet up -----
BOBANANA_MAX_PLAN_REVISIONS=3
BOBANANA_MAX_EXEC_REVISIONS=3
BOBANANA_MAX_STEPS=20
# Per-step ReAct tool budget. Failed/empty-path/cached calls do NOT count.
BOBANANA_MAX_TOOL_ITERS=24
# After all steps run, a directive gate verifies the plan's key_directives are met;
# if not, it loops back this many times to finish the remaining work.
BOBANANA_MAX_DIRECTIVE_REVISIONS=3
# Seconds before a shell command is killed; a timeout triggers a replan.
BOBANANA_SHELL_TIMEOUT=120
# Cache read_file/list_dir/read-only shell results in structured memory so the agent
# doesn't repeat the same exploration. Invalidated on any write side-effect.
BOBANANA_ENABLE_EXPLORATION_CACHE=true

# ----- Interruptibility (checkpoints / timeout) -----
# Whole-task wall-clock seconds; 0 = no timeout. On timeout the run pauses at the next
# node boundary and waits for you (continue / rollback / abort / new instruction).
BOBANANA_TASK_TIMEOUT=0
# Per-LLM-call seconds (bounds each node so timeouts are detected promptly).
BOBANANA_LLM_TIMEOUT=90
# MemorySaver checkpoints enable /resume and /rollback within a session.
BOBANANA_ENABLE_CHECKPOINTS=true

# ----- Observability / logging -----
# DEBUG | INFO | WARNING | ERROR  (or pass --debug / use /debug at runtime)
BOBANANA_LOG_LEVEL=INFO

# ----- Skills / MCP / web reach -----
BOBANANA_ENABLE_WEB_TOOLS=true
# os.pathsep-separated dirs scanned for SKILL.md
# (defaults: ~/.agents/skills, ~/.cursor/skills, <workspace>/skills)
# BOBANANA_SKILL_DIRS=C:\Users\you\.agents\skills;C:\proj\skills
# Path to an mcp.json (Claude/Cursor-style mcpServers map). Defaults to <workspace>/mcp.json
# BOBANANA_MCP_CONFIG=mcp.json
BOBANANA_AGENT_REACH_REPO=https://github.com/Panniantong/Agent-Reach.git

# ----- Meta-prompting & delivery gate -----
# Large/unclear tasks get a quick meta-prompting pass (clarify or refine) before running.
BOBANANA_ENABLE_METAPROMPT=true
# Auto-load the local code-delivery-gate SKILL.md and inject it for code tasks.
BOBANANA_ENABLE_DELIVERY_GATE=true
BOBANANA_DELIVERY_GATE_SKILL=code-delivery-gate

# ----- Tool plugins (.bobanana/tools/ drop-in YAML + Python) -----
BOBANANA_ENABLE_TOOL_PLUGINS=true
# Comma-separated grants: read, write, shell, network, admin
BOBANANA_TOOL_PERMISSIONS=read,write,shell,network

# ----- Workspace / storage -----
# Directory the agent is allowed to read/write in. Defaults to current working dir.
# BOBANANA_WORKSPACE=.
# Where memory stores live (relative to workspace).
BOBANANA_DATA_DIR=.bobanana
